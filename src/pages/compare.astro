---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Compare } from '../components/compare/Compare.tsx';
---
<BaseLayout
  title="Compare Mutual Funds: Growth, Returns & Risk Side by Side"
  description="Compare up to four Indian mutual funds side by side: growth of the same investment, 1/3/5-year returns, SIP returns, volatility and drawdown. Free, no sign-up."
  path="/compare/"
>
  <h1 class="text-2xl font-semibold tracking-tight">Compare mutual funds</h1>
  <p class="mt-1 mb-5 max-w-3xl text-sm text-muted">Pick two to four funds to see how the same amount invested would have grown, with every metric side by side.</p>
  <Compare client:load />
</BaseLayout>
