---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { breadcrumbLd } from '../../lib/seo.ts';

const guides = (await getCollection('learn')).sort((a, b) => a.data.order - b.data.order);
const groups = ['Basics', 'Returns and risk', 'Fund types', 'Tax', 'Government schemes', 'Planning'] as const;
---
<BaseLayout
  title="Learn: Mutual Funds, PPF, Savings Schemes, Rent vs Buy"
  description="Plain-language guides for Indian savers: mutual funds, SIP, expense ratio and tax, plus PPF, Sukanya Samriddhi, Post Office schemes and renting vs buying a home."
  path="/learn/"
  alternates={[{ lang: 'en', path: '/learn/' }, { lang: 'hi', path: '/hi/learn/' }]}
  jsonLd={[breadcrumbLd([{ name: 'Home', url: new URL('/', Astro.site).toString() }, { name: 'Learn', url: new URL('/learn/', Astro.site).toString() }])]}
>
  <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Learn' }]} />
  <h1 class="text-2xl font-semibold tracking-tight">Learn</h1>
  <p class="mt-2 max-w-3xl text-sm text-muted">Short, plain-language guides on the terms and numbers you meet when you save and invest in India.</p>
  {groups.map((g) => (
    <section class="mt-8" aria-labelledby={`g-${g}`}>
      <h2 id={`g-${g}`} class="mb-3 text-lg font-semibold tracking-tight">{g}</h2>
      <ul class="grid grid-cols-[minmax(0,1fr)] gap-3 sm:grid-cols-2">
        {guides.filter((x) => x.data.group === g).map((x) => (
          <li><a href={`/learn/${x.id}/`} class="block h-full rounded-md border border-line p-4 hover:bg-subtle">
            <span class="font-medium">{x.data.title}</span>
            <span class="mt-1 block text-sm text-muted">{x.data.description}</span>
          </a></li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
