---
/**
 * Contact page. Set PUBLIC_CONTACT_EMAIL at build time (e.g. in the hosting environment) to show
 * the address. Google AdSense requires a way to contact the site owner, so set this before applying.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
const email = import.meta.env.PUBLIC_CONTACT_EMAIL;
---
<BaseLayout title="Contact" description="Contact MF Screener to report a data error, suggest an improvement or ask a question." path="/contact/">
  <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Contact' }]} />
  <h1 class="text-2xl font-semibold tracking-tight">Contact</h1>
  <div class="prose-mf mt-5">
    <p>Found a number that looks wrong, a missing fund, or have an idea? We read every message.</p>
    {email
      ? <p>Email: <a href={`mailto:${email}`}>{email}</a></p>
      : <p>Contact details are not configured for this build.</p>}
    <p>When reporting a data problem, please include the fund name, the figure you saw and the figure you expected. See the <a href="/methodology/">methodology</a> for how numbers are calculated.</p>
    <p>We cannot give personal investment advice. See the <a href="/disclaimer/">disclaimer</a>.</p>
  </div>
</BaseLayout>
