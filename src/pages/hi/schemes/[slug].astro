---
/** One Government savings scheme calculator page (hi). */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SchemePageBody from '../../../components/schemes/SchemePageBody.astro';
import { SCHEMES_HI as PAGES, SCHEME_SUMMARY_HI as SUMMARY } from '../../../lib/schemeContent.hi.ts';
import { breadcrumbLd, calculatorLd, faqLd } from '../../../lib/seo.ts';

export function getStaticPaths() {
  return PAGES.map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}
const { slug } = Astro.props;
const page = PAGES.find((p) => p.slug === slug)!;
const path = `/hi/schemes/${page.slug}/`;
const url = new URL(path, Astro.site).toString();
---
<BaseLayout title={page.title} description={page.description} path={path} lang="hi"
  alternates={[{ lang: 'en', path: `/schemes/${page.slug}/` }, { lang: 'hi', path: `/hi/schemes/${page.slug}/` }]}
  jsonLd={[
    breadcrumbLd([
      { name: 'होम', url: new URL('/', Astro.site).toString() },
      { name: 'सरकारी योजनाएँ', url: new URL('/hi/schemes/', Astro.site).toString() },
      { name: page.name, url },
    ]),
    calculatorLd(page.name, url, page.description),
    faqLd(page.faqs),
  ]}>
  <Breadcrumbs crumbs={[{ name: 'होम', href: '/' }, { name: 'सरकारी योजनाएँ', href: '/hi/schemes/' }, { name: page.name }]} />
  <SchemePageBody page={page} lang="hi" others={PAGES.filter((p) => p.slug !== page.slug).map((p) => ({ slug: p.slug, name: p.name }))} />
</BaseLayout>
