---
/** One calculator page (hi): the same calculator in Hindi, how it works, a worked example, FAQ, JSON-LD. */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Faq from '../../../components/Faq.astro';
import ToolCalculator from '../../../components/calculators/ToolCalculator.astro';
import { breadcrumbLd, calculatorLd, faqLd } from '../../../lib/seo.ts';
import { TOOLS } from '../../../lib/tools.ts';
import { TOOL_GUIDES } from '../../../lib/toolGuides.ts';
import { TOOLS_HI } from '../../../lib/toolsContent.hi.ts';

export function getStaticPaths() {
  return TOOLS.map((t) => ({ params: { slug: t.slug }, props: { slug: t.slug } }));
}
const { slug } = Astro.props;
const tool = TOOLS.find((t) => t.slug === slug)!;
const hi = TOOLS_HI[slug];
const path = `/hi/tools/${slug}/`;
const url = new URL(path, Astro.site).toString();
const guide = TOOL_GUIDES[tool.kind];
const others = TOOLS.filter((t) => t.slug !== slug);
---
<BaseLayout
  title={hi.title}
  description={hi.description}
  path={path}
  lang="hi"
  alternates={[{ lang: 'en', path: `/tools/${slug}/` }, { lang: 'hi', path }]}
  jsonLd={[
    breadcrumbLd([
      { name: 'होम', url: new URL('/', Astro.site).toString() },
      { name: 'कैलकुलेटर', url: new URL('/hi/tools/', Astro.site).toString() },
      { name: hi.name, url },
    ]),
    calculatorLd(hi.name, url, hi.description),
    faqLd(hi.faqs),
  ]}
>
  <Breadcrumbs crumbs={[{ name: 'होम', href: '/' }, { name: 'कैलकुलेटर', href: '/hi/tools/' }, { name: hi.name }]} />
  <h1 class="text-2xl font-semibold tracking-tight">{hi.h1}</h1>
  <p class="mt-2 mb-6 max-w-3xl text-sm text-muted">{hi.intro}</p>

  <ToolCalculator kind={tool.kind} lang="hi" />

  <section class="mt-10 max-w-3xl" aria-labelledby="how-h">
    <h2 id="how-h" class="text-lg font-semibold tracking-tight">यह कैसे काम करता है</h2>
    <p class="mt-3 rounded-md border border-line bg-subtle p-3 font-mono text-sm leading-relaxed">{hi.formula}</p>
    {hi.how.map((p) => <p class="mt-3 text-sm leading-relaxed text-muted">{p}</p>)}
    <p class="mt-3 text-sm leading-relaxed"><strong class="font-medium">उदाहरण।</strong> {hi.example()}</p>
  </section>

  <p class="mt-8 max-w-3xl text-sm" data-testid="tool-guide">गाइड पढ़ें: <a class="underline" href={`/hi/learn/${guide.slug}/`}>{guide.titleHi}</a>।</p>

  <Faq faqs={hi.faqs} heading="अक्सर पूछे जाने वाले सवाल" />

  <section class="mt-10" aria-labelledby="more-h">
    <h2 id="more-h" class="text-lg font-semibold tracking-tight">दूसरे कैलकुलेटर</h2>
    <ul class="mt-3 flex flex-wrap gap-2">
      {others.map((t) => <li><a class="inline-block rounded-md border border-line px-3 py-1.5 text-sm hover:bg-subtle" href={`/hi/tools/${t.slug}/`}>{TOOLS_HI[t.slug].name}</a></li>)}
    </ul>
  </section>
</BaseLayout>
