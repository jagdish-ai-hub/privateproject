---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import { Screener } from '../components/screener/Screener.tsx';
import { loadScreener } from '../lib/data.ts';
import { popularPairs } from '../lib/popular.ts';
import { siteLd } from '../lib/seo.ts';

const data = loadScreener();
const pairs = popularPairs(data, ['Flexi Cap', 'Large Cap', 'Mid Cap', 'Small Cap']);
---
<BaseLayout
  title="Compare Mutual Funds in India: Returns, Risk & Costs"
  description="Compare Indian mutual funds free: returns, SIP returns, risk, expense ratio and fund size for every scheme, side by side with plain-English insights. No sign-up."
  path="/"
  jsonLd={siteLd(new URL('/', Astro.site).toString())}
>
  <Hero slot="hero" schemes={data.count} fundHouses={data.dict.amc.length} asOf={data.asOf} pairs={pairs} />
  <section id="screener" aria-labelledby="screener-h" class="scroll-mt-4">
    <h2 id="screener-h" class="text-2xl font-semibold tracking-tight">Mutual fund screener</h2>
    <p class="mt-1 mb-5 max-w-3xl text-sm text-muted">
      Filter every active scheme by category, plan, returns, risk, expense ratio and size, then sort, share the link or export a CSV.
      Calculated from official AMFI NAV history; <a class="underline" href="/methodology/">see how</a>.
    </p>
    <Screener client:load />
  </section>
</BaseLayout>
