---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { TOOLS } from '../../lib/tools.ts';
---
<BaseLayout
  title="Financial Calculators: SIP, EMI, FD, XIRR, Fuel Cost and More"
  description="Free calculators for India: SIP, lumpsum, SWP, CAGR, XIRR, EMI, home loan eligibility, FD, inflation, rent vs buy, fuel cost, mileage, gold. Every formula shown, no sign-up."
  path="/tools/"
  alternates={[{ lang: 'en', path: '/tools/' }, { lang: 'hi', path: '/hi/tools/' }]}
>
  <Breadcrumbs crumbs={[{ name: 'Home', href: '/' }, { name: 'Calculators' }]} />
  <h1 class="text-2xl font-semibold tracking-tight">Calculators</h1>
  <p class="mt-2 max-w-3xl text-sm text-muted">Plan investments, loans and everyday costs with simple, transparent calculators. Every page shows the formula it uses.</p>
  <ul class="mt-6 grid grid-cols-[minmax(0,1fr)] gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {TOOLS.map((t) => (
      <li><a href={`/tools/${t.slug}/`} class="block h-full rounded-md border border-line p-4 hover:bg-subtle">
        <span class="font-medium">{t.name}</span>
        <span class="mt-1 block text-sm text-muted">{t.description}</span>
      </a></li>
    ))}
  </ul>
</BaseLayout>
