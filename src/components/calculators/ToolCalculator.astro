---
/** Picks the calculator island for a tool kind, in the page's language. */
import { Calculator } from './Calculator.tsx';
import { RentVsBuy } from './RentVsBuy.tsx';
import { VehicleCalculator } from './VehicleCalculator.tsx';
import { MetalCalculator } from './MetalCalculator.tsx';
import { LoanCalculator } from './LoanCalculator.tsx';
import { DepositCalculator } from './DepositCalculator.tsx';
import { EligibilityCalculator } from './EligibilityCalculator.tsx';
import { FuelCalculator } from './FuelCalculator.tsx';
import { GoldSipCalculator } from './GoldSipCalculator.tsx';
import { XirrCalculator } from './XirrCalculator.tsx';
import type { Tool } from '../../lib/tools.ts';

interface Props { kind: Tool['kind']; lang: 'en' | 'hi' }
const { kind, lang } = Astro.props;
---
{kind === 'rentbuy' ? <RentVsBuy client:load lang={lang} />
  : kind === 'car' || kind === 'evpetrol' ? <VehicleCalculator client:load kind={kind} lang={lang} />
  : kind === 'jewellery' || kind === 'metalreturn' ? <MetalCalculator client:load kind={kind === 'jewellery' ? 'jewellery' : 'return'} lang={lang} />
  : kind === 'homeloan' || kind === 'carloan' || kind === 'personalloan' || kind === 'emi' ? <LoanCalculator client:load kind={kind} lang={lang} />
  : kind === 'fd' || kind === 'inflation' ? <DepositCalculator client:load kind={kind} lang={lang} />
  : kind === 'eligibility' ? <EligibilityCalculator client:load />
  : kind === 'fuelcost' || kind === 'mileage' ? <FuelCalculator client:load kind={kind} />
  : kind === 'goldsip' ? <GoldSipCalculator client:load />
  : kind === 'xirr' ? <XirrCalculator client:load />
  : <Calculator client:load kind={kind} lang={lang} />}
