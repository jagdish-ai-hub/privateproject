---
/** Light/dark toggle. Persists the choice in localStorage (wrapped in try/catch). */
---
<button id="theme-toggle" type="button" class="h-10 w-10 rounded-md border border-line text-sm hover:bg-subtle sm:h-8 sm:w-8" aria-label="Toggle theme">
  <svg class="mx-auto" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" data-icon><circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M8 1.75a6.25 6.25 0 0 1 0 12.5z" fill="currentColor" /></svg>
</button>
<script>
  const btn = document.getElementById('theme-toggle');
  btn?.addEventListener('click', () => {
    const next = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch {}
    window.dispatchEvent(new CustomEvent('themechange', { detail: next }));
  });
</script>
