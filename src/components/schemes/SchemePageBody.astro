---
/**
 * Body of one Government savings scheme calculator page, shared by the English (/schemes/…) and
 * Hindi (/hi/schemes/…) routes. Shows: the calculator, the notified rate with its notice and date
 * (and a warning when the quarter is over), how the money is calculated, a worked example produced
 * by the same code, the rules, tax, FAQ and links to the other schemes.
 */
import Faq from '../Faq.astro';
import { SchemeCalculator } from './SchemeCalculator.tsx';
import { SMALL_SAVINGS, ratesMayBeStale } from '../../data/small-savings.ts';
import type { SchemePage } from '../../lib/schemeContent.ts';

interface Props { page: SchemePage; lang: 'en' | 'hi'; others: { slug: string; name: string }[] }
const { page, lang, others } = Astro.props;
const hi = lang === 'hi';
const base = hi ? '/hi/schemes/' : '/schemes/';
const L = hi
  ? { rateH: 'इस्तेमाल की गई ब्याज दर', period: 'अवधि', notice: 'अधिसूचना', checked: 'जाँचा गया', sources: 'स्रोत', stale: 'यह तिमाही ख़त्म हो चुकी है, इसलिए दरें बदल गई हो सकती हैं। नई अधिसूचना जाँचें।', howH: 'हिसाब कैसे होता है', exampleH: 'उदाहरण जिसे आप ख़ुद जाँच सकते हैं', rulesH: 'नियम एक नज़र में', taxH: 'टैक्स', faq: 'अक्सर पूछे जाने वाले सवाल', moreH: 'दूसरी सरकारी योजनाएँ', all: 'सभी योजनाओं की दरें' }
  : { rateH: 'Rate used', period: 'Period', notice: 'Notice', checked: 'Checked', sources: 'Sources', stale: 'This quarter has ended, so the rates may have changed. Check the latest notice.', howH: 'How the money is calculated', exampleH: 'A worked example you can check', rulesH: 'Rules at a glance', taxH: 'Tax', faq: 'Frequently asked questions', moreH: 'Other Government schemes', all: 'Rates of all schemes' };
const today = new Date().toISOString().slice(0, 10);
const stale = ratesMayBeStale(today);
const fmtDate = (iso: string) => iso.split('-').reverse().join('.');
const GUIDES: Record<string, { slug: string; title: string; titleHi: string }[]> = {
  ppf: [{ slug: 'ppf-explained', title: 'PPF explained', titleHi: 'PPF समझें' }, { slug: 'ppf-vs-mutual-funds', title: 'PPF vs mutual funds', titleHi: 'PPF बनाम म्यूचुअल फंड' }],
  ssy: [{ slug: 'sukanya-samriddhi-yojana-explained', title: 'Sukanya Samriddhi Yojana explained', titleHi: 'सुकन्या समृद्धि योजना समझें' }],
};
const POST_OFFICE = { slug: 'post-office-savings-schemes-explained', title: 'Post Office savings schemes explained', titleHi: 'पोस्ट ऑफिस बचत योजनाएँ समझें' };
const COMPARED = { slug: 'small-savings-schemes-compared', title: 'Government savings schemes compared', titleHi: 'सरकारी बचत योजनाओं की तुलना' };
const guides = [...(GUIDES[page.kind] ?? [POST_OFFICE]), COMPARED].map((g) => ({ href: `${hi ? '/hi' : ''}/learn/${g.slug}/`, title: hi ? g.titleHi : g.title }));
---
<h1 class="text-2xl font-semibold tracking-tight">{page.h1}</h1>
<p class="mt-2 mb-6 max-w-3xl text-sm text-muted">{page.intro}</p>

<SchemeCalculator client:load kind={page.kind} rates={SMALL_SAVINGS.rates} kvpMonths={SMALL_SAVINGS.kvpMonths} lang={lang} />

<section class="mt-8 max-w-3xl rounded-md border border-line bg-subtle p-4 text-sm" aria-labelledby="rate-h" data-testid="rate-notice">
  <h2 id="rate-h" class="font-semibold">{L.rateH}</h2>
  {stale && <p class="mt-2 font-medium" style="color: var(--neg)" role="status" data-testid="stale-rates">{L.stale}</p>}
  <dl class="mt-2 grid grid-cols-[max-content_1fr] gap-x-4 gap-y-1">
    <dt class="text-muted">{L.period}</dt><dd>{hi ? SMALL_SAVINGS.period.labelHi : SMALL_SAVINGS.period.label}</dd>
    <dt class="text-muted">{L.notice}</dt><dd>{SMALL_SAVINGS.notice.number}, {fmtDate(SMALL_SAVINGS.notice.date)}</dd>
    <dt class="text-muted">{L.checked}</dt><dd>{fmtDate(SMALL_SAVINGS.checked)}</dd>
  </dl>
  <p class="mt-2 text-xs text-muted">{L.sources}: {SMALL_SAVINGS.sources.map((s, i) => <>{i > 0 && ' · '}<a class="underline" href={s.url} rel="nofollow noopener" target="_blank">{s.name}</a></>)}</p>
</section>

<section class="mt-8 max-w-3xl" aria-labelledby="how-h">
  <h2 id="how-h" class="text-lg font-semibold tracking-tight">{L.howH}</h2>
  <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm leading-relaxed text-muted" data-testid="conventions">
    {page.conventions.map((c) => <li>{c}</li>)}
  </ul>
  <p class="mt-3 rounded-md border border-line bg-subtle p-3 font-mono text-sm leading-relaxed">{page.formula}</p>
  <h3 class="mt-5 font-medium">{L.exampleH}</h3>
  <p class="mt-1 text-sm leading-relaxed" data-testid="worked-example">{page.example()}</p>
</section>

<section class="mt-8 max-w-3xl" aria-labelledby="rules-h">
  <h2 id="rules-h" class="text-lg font-semibold tracking-tight">{L.rulesH}</h2>
  <dl class="mt-3 grid grid-cols-[max-content_1fr] gap-x-6 gap-y-1.5 rounded-md border border-line p-4 text-sm">
    {page.rules.map(([k, v]) => <><dt class="text-muted">{k}</dt><dd>{v}</dd></>)}
  </dl>
  <h3 class="mt-5 font-medium">{L.taxH}</h3>
  <p class="mt-1 text-sm leading-relaxed text-muted">{page.tax}</p>
</section>

<Faq faqs={page.faqs} heading={L.faq} />

<section class="mt-10" aria-labelledby="more-h">
  <h2 id="more-h" class="text-lg font-semibold tracking-tight">{L.moreH}</h2>
  <ul class="mt-3 flex flex-wrap gap-2">
    {others.map((o) => <li><a class="inline-block rounded-md border border-line px-3 py-1.5 text-sm hover:bg-subtle" href={`${base}${o.slug}/`}>{o.name}</a></li>)}
    <li><a class="inline-block rounded-md border border-line px-3 py-1.5 text-sm font-medium hover:bg-subtle" href={base}>{L.all}</a></li>
  </ul>
</section>

<section class="mt-10" aria-labelledby="guides-h" data-testid="scheme-guides">
    <h2 id="guides-h" class="text-lg font-semibold tracking-tight">{hi ? 'और पढ़ें' : 'Read more'}</h2>
    <ul class="mt-3 flex flex-wrap gap-2">
      {guides.map((g) => <li><a class="inline-block rounded-md border border-line px-3 py-1.5 text-sm hover:bg-subtle" href={g.href}>{g.title}</a></li>)}
    </ul>
  </section>
