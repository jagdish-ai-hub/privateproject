---
/**
 * Static table of funds (used on category, AMC and "similar funds" blocks).
 * Numbers use the shared formatters; missing values show a dash, never 0.
 */
import { formatNav, formatPct, signClass } from '../lib/format.ts';
import type { Fund } from '../lib/data.ts';
interface Props { funds: Fund[]; caption: string; showCategory?: boolean }
const { funds, caption, showCategory = false } = Astro.props;
const cols = [['r1y', '1Y'], ['r3y', '3Y'], ['r5y', '5Y'], ['sip3y', 'SIP 3Y']] as const;
---
<div class="overflow-auto rounded-md border border-line">
  <table class="w-full border-collapse text-sm">
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr class="border-b border-line text-xs text-muted">
        <th scope="col" class="px-3 py-2.5 text-left font-medium">Fund</th>
        {showCategory && <th scope="col" class="px-3 py-2.5 text-left font-medium">Category</th>}
        <th scope="col" class="px-3 py-2.5 text-right font-medium">NAV (₹)</th>
        {cols.map(([, label]) => <th scope="col" class="px-3 py-2.5 text-right font-medium">{label}</th>)}
      </tr>
    </thead>
    <tbody>
      {funds.map((f) => (
        <tr class="border-b border-line last:border-0 hover:bg-subtle">
          <td class="px-3 py-2.5"><a href={`/fund/${f.slug}/`} class="font-medium hover:underline">{f.name}</a></td>
          {showCategory && <td class="whitespace-nowrap px-3 py-2.5 text-muted">{f.category}</td>}
          <td class="num px-3 py-2.5">{formatNav(f.nav)}</td>
          {cols.map(([k]) => <td class={`num px-3 py-2.5 ${signClass(f.metrics[k])}`}>{formatPct(f.metrics[k])}</td>)}
        </tr>
      ))}
    </tbody>
  </table>
</div>
