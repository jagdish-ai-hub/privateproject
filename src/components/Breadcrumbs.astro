---
/** Visible breadcrumb trail. The same list drives the BreadcrumbList JSON-LD on the page. */
interface Props { crumbs: { name: string; href?: string }[] }
const { crumbs } = Astro.props;
---
<nav aria-label="Breadcrumb" class="mb-3 text-xs text-muted">
  <ol class="flex flex-wrap items-center gap-1.5">
    {crumbs.map((c, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true">/</span>}
        {c.href ? <a href={c.href} class="hover:text-fg hover:underline">{c.name}</a> : <span aria-current="page" class="text-fg">{c.name}</span>}
      </li>
    ))}
  </ol>
</nav>
