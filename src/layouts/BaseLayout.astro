---
/**
 * Page shell: <head> (title, description, canonical, Open Graph, JSON-LD),
 * header with search + theme toggle, footer with the compliance disclaimer.
 *
 * Props:
 * - title: page title (the site name is appended)
 * - description: meta description
 * - path: canonical path, e.g. "/learn/direct-vs-regular"
 * - jsonLd: optional array of schema.org objects emitted as JSON-LD
 * - lang: 'en' (default) or 'hi'; sets <html lang>, Open Graph locale and the nav / footer language
 * - alternates: the same page in each language, emitted as hreflang links and shown as a language switch
 */
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import Logo from '../components/Logo.astro';

interface Props {
  title: string;
  description: string;
  path?: string;
  jsonLd?: Record<string, unknown>[];
  lang?: 'en' | 'hi';
  alternates?: { lang: 'en' | 'hi'; path: string }[];
}
// Only a plausible Clarity project id (letters and digits) turns the script on.
const clarityRaw = import.meta.env.PUBLIC_CLARITY_ID;
const clarityId = typeof clarityRaw === 'string' && /^[a-z0-9]{6,20}$/i.test(clarityRaw) ? clarityRaw : '';
const { title, description, path = Astro.url.pathname, jsonLd = [], lang = 'en', alternates = [] } = Astro.props;
const hi = lang === 'hi';
const other = alternates.find((a) => a.lang !== lang);
const canonical = new URL(path, Astro.site).toString();
const fullTitle = title.includes('Mutual Fund Compare') ? title : `${title} | Mutual Fund Compare`;
// The first item is the main call to action: it goes straight to the screener on the home page.
const nav = hi
  ? [
      { href: '/#screener', label: 'म्यूचुअल फंड तुलना', cta: true },
      { href: '/compare/', label: 'आमने-सामने', cta: false },
      { href: '/hi/schemes/', label: 'सरकारी योजनाएँ', cta: false },
      { href: '/hi/tools/', label: 'कैलकुलेटर', cta: false },
      { href: '/learn/', label: 'सीखें', cta: false },
    ]
  : [
      { href: '/#screener', label: 'Compare Mutual Funds', cta: true },
      { href: '/compare/', label: 'Side by side', cta: false },
      { href: '/schemes/', label: 'Govt schemes', cta: false },
      { href: '/tools/', label: 'Calculators', cta: false },
      { href: '/learn/', label: 'Learn', cta: false },
    ];
---
<!doctype html>
<html lang={hi ? 'hi-IN' : 'en-IN'} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang === 'hi' ? 'hi-IN' : 'en-IN'} href={new URL(a.path, Astro.site).toString()} />)}
    {alternates.length > 0 && <link rel="alternate" hreflang="x-default" href={new URL((alternates.find((a) => a.lang === 'en') ?? alternates[0]).path, Astro.site).toString()} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Mutual Fund Compare" />
    <meta property="og:locale" content={hi ? 'hi_IN' : 'en_IN'} />
    <meta property="og:image" content={new URL('/og.png', Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
    <!-- Runs before paint so the saved / system theme never flashes. -->
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    {import.meta.env.PUBLIC_ADSENSE_CLIENT && (
      <script is:inline async crossorigin="anonymous" src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${import.meta.env.PUBLIC_ADSENSE_CLIENT}`}></script>
    )}
    {clarityId && (
      <script is:inline define:vars={{ clarityId }}>
        // Microsoft Clarity (free heatmaps and session replays). Loaded after the page has finished loading so it never delays first paint.
        addEventListener('load', function () {
          (function (c, l, a, r, i, t, y) {
            c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
            t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
            y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
          })(window, document, 'clarity', 'script', clarityId);
        });
      </script>
    )}
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <header class="border-b border-line">
      <div class="mx-auto flex min-h-14 max-w-7xl flex-wrap items-center gap-x-6 gap-y-1 px-4 py-2">
        <a href="/" class="flex items-center gap-2 font-semibold tracking-tight" aria-label="Mutual Fund Compare, home"><Logo size={24} /><span>Mutual Fund Compare</span></a>
        <nav class="order-3 flex w-full gap-4 overflow-x-auto text-sm text-muted sm:order-none sm:w-auto" aria-label="Main">
          {nav.map((n) => <a href={n.href} class={n.cta ? 'whitespace-nowrap rounded-md bg-accent px-3 py-1 font-medium text-accent-fg hover:opacity-90' : 'whitespace-nowrap py-1 hover:text-fg'}>{n.label}</a>)}
        </nav>
        <div class="ml-auto flex items-center gap-3">
          {other && <a href={other.path} lang={other.lang === 'hi' ? 'hi' : 'en'} hreflang={other.lang === 'hi' ? 'hi-IN' : 'en-IN'} class="rounded-md border border-line px-2.5 py-1 text-sm hover:bg-subtle" data-testid="lang-switch">{other.lang === 'hi' ? 'हिंदी' : 'English'}</a>}
          <ThemeToggle />
        </div>
      </div>
    </header>
    <slot name="hero" />
    <main class="mx-auto max-w-7xl px-4 py-6"><slot /></main>
    <footer class="border-t border-line mt-12">
      <div class="mx-auto max-w-7xl px-4 py-6 text-xs text-muted space-y-2">
        {hi ? (
          <>
            <p>म्यूचुअल फंड निवेश बाज़ार जोखिमों के अधीन है। योजना से जुड़े सभी दस्तावेज़ ध्यान से पढ़ें। पिछला प्रदर्शन भविष्य के रिटर्न का संकेत नहीं है।</p>
            <p>यह जानकारी सिर्फ़ शिक्षा के लिए है, निवेश सलाह नहीं। सरकारी योजनाओं की दरें वित्त मंत्रालय की अधिसूचना से ली गई हैं।</p>
          </>
        ) : (
          <>
            <p>Mutual fund investments are subject to market risks. Read all scheme related documents carefully. Past performance is not indicative of future returns.</p>
            <p>Educational information only; not investment advice. Data: NAV from AMFI via <a class="underline" href="https://www.mfapi.in">MFapi.in</a>; expense ratio and AUM from AMFI; Government scheme rates from Ministry of Finance notices.</p>
          </>
        )}
        <p><a class="underline" href="/methodology/">Methodology</a> · <a class="underline" href="/about/">About</a> · <a class="underline" href="/privacy/">Privacy</a> · <a class="underline" href="/disclaimer/">Disclaimer</a></p>
      </div>
    </footer>
  </body>
</html>
