---
/**
 * Page shell: <head> (title, description, canonical, Open Graph, JSON-LD),
 * header with search + theme toggle, footer with the compliance disclaimer.
 *
 * Props:
 * - title: page title (the site name is appended)
 * - description: meta description
 * - path: canonical path, e.g. "/learn/direct-vs-regular"
 * - jsonLd: optional array of schema.org objects emitted as JSON-LD
 */
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description: string;
  path?: string;
  jsonLd?: Record<string, unknown>[];
}
const { title, description, path = Astro.url.pathname, jsonLd = [] } = Astro.props;
const canonical = new URL(path, Astro.site).toString();
const fullTitle = title.includes('Mutual Fund Compare') ? title : `${title} | Mutual Fund Compare`;
// The first item is the main call to action: it goes straight to the screener on the home page.
const nav = [
  { href: '/#screener', label: 'Compare Mutual Funds', cta: true },
  { href: '/compare/', label: 'Side by side', cta: false },
  { href: '/tools/', label: 'Calculators' },
  { href: '/learn/', label: 'Learn' },
];
---
<!doctype html>
<html lang="en-IN" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Mutual Fund Compare" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={new URL('/og.png', Astro.site).toString()} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Runs before paint so the saved / system theme never flashes. -->
    <script is:inline>
      (function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    {import.meta.env.PUBLIC_ADSENSE_CLIENT && (
      <script is:inline async crossorigin="anonymous" src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${import.meta.env.PUBLIC_ADSENSE_CLIENT}`}></script>
    )}
    {jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <header class="border-b border-line">
      <div class="mx-auto flex min-h-14 max-w-7xl flex-wrap items-center gap-x-6 gap-y-1 px-4 py-2">
        <a href="/" class="font-semibold tracking-tight">Mutual Fund Compare</a>
        <nav class="order-3 flex w-full gap-4 overflow-x-auto text-sm text-muted sm:order-none sm:w-auto" aria-label="Main">
          {nav.map((n) => <a href={n.href} class={n.cta ? 'whitespace-nowrap rounded-md bg-accent px-3 py-1 font-medium text-accent-fg hover:opacity-90' : 'whitespace-nowrap py-1 hover:text-fg'}>{n.label}</a>)}
        </nav>
        <div class="ml-auto"><ThemeToggle /></div>
      </div>
    </header>
    <slot name="hero" />
    <main class="mx-auto max-w-7xl px-4 py-6"><slot /></main>
    <footer class="border-t border-line mt-12">
      <div class="mx-auto max-w-7xl px-4 py-6 text-xs text-muted space-y-2">
        <p>Mutual fund investments are subject to market risks. Read all scheme related documents carefully. Past performance is not indicative of future returns.</p>
        <p>Educational information only; not investment advice. Data: NAV from AMFI via <a class="underline" href="https://www.mfapi.in">MFapi.in</a>; expense ratio and AUM from AMFI.</p>
        <p><a class="underline" href="/methodology/">Methodology</a> · <a class="underline" href="/about/">About</a> · <a class="underline" href="/privacy/">Privacy</a> · <a class="underline" href="/disclaimer/">Disclaimer</a></p>
      </div>
    </footer>
  </body>
</html>
