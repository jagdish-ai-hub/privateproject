{
  "name": "mf-screener",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Free, no-signup Indian mutual fund screener built on AMFI / MFapi.in NAV data.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "test": "vitest run",
    "build:e2e": "MAX_FUND_PAGES=30 astro build",
    "test:e2e": "npm run build:e2e && playwright test",
    "data:build": "node --experimental-strip-types scripts/build-data.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/preact": "^6.0.5",
    "@astrojs/sitemap": "^3.7.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.5",
    "geist": "^1.7.2",
    "lightweight-charts": "^5.2.1",
    "preact": "^10.29.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^63.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
