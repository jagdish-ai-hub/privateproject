{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "src", "scripts", "tests", "e2e"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "allowImportingTsExtensions": true,
    "paths": { "@/*": ["./src/*"] }
  }
}
